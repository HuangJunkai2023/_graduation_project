# 复制为本目录 .env；不要将真实密钥提交到 Git 或发到聊天中。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-10-13 核对的官方示例模型名；也可改为账户实际可用的模型。
DEEPSEEK_MODEL=deepseek-flash
API_TIMEOUT_SECONDS=60

# 仅向量 / 混合检索需要另配 embedding 服务；不要填写 DeepSeek 对话模型。
# 地址应是兼容 /embeddings 的 API 基址，模型须为该服务的文本向量模型。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=5
VECTOR_WEIGHT=0.6
# 初始启发式门槛，须仅用开发集调参；不是概率或经过校准的置信度。
MIN_LEXICAL_COVERAGE=0.2
MIN_COSINE_SIMILARITY=0.35
