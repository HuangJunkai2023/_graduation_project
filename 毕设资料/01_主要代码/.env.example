# 复制本文件为 .env 并填写真实值
# 在线大模型 / 向量化
ZHIPUAI_API_KEY=your_api_key_here
EMBEDDING_MODEL=embedding-3
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# 文本切分
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 检索
TOP_K=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# 知识库持久化文件
KB_PATH=kb/knowledge_base.json

# 多轮记忆轮数
MEMORY_ROUNDS=5
