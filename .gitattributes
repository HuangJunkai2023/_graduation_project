# Text sources use LF; Word, PDF and figures remain binary artifacts.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
